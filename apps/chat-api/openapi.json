  "info": {
    "title": "API do chat",
    "description": "Contrato REST da API do chat do Full Cycle Chat.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ana@empresa.com.br",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "PersonResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "username": {
            "type": "string",
            "description": "O @usuário, sem o @"
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "username",
          "email"
        ]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "person": {
            "$ref": "#/components/schemas/PersonResponse"
          }
        },
        "required": [
          "token",
          "person"
        ]
      }
    }
  }
}
